flowchart LR
  Parent["👵 Parent<br/>(senior, 50+)"]
  Child["👩 Adult child<br/>(primary contact)"]
  Second["🧑 Second contact<br/>(optional)"]
  Scammer["☎️ Scammer<br/>(poses as bank, police,<br/>court, courier, friend)"]
  System["🛡️ Semak Dulu bot<br/>(QR check + alerts)"]
  TG["Telegram<br/>Bot API"]

  Scammer -- "sends QR + asks for money" --> Parent
  Parent -- "forwards QR, taps answers" --> TG
  Child -- "registers, taps 'Saya uruskan'" --> TG
  Second -- "accepts invite, taps ack" --> TG
  TG <--> System
  System -- "STOP / VERIFY verdict" --> TG
  System -- "alert on STOP" --> TG
